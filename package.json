{
  "name": "openfront-client",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.1.0 <13"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build-dev": "concurrently \"tsc --noEmit\" \"vite build --mode development\"",
    "build-prod": "concurrently --kill-others-on-fail \"tsc --noEmit\" \"vite build\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/engine-api && tsc --noEmit -p packages/engine-lib && tsc --noEmit -p packages/engine && tsc --noEmit -p packages/engine/src/worker && tsc --noEmit -p packages/shared && tsc --noEmit -p packages/zbin",
    "start:client": "vite",
    "start:server": "cross-env GAME_ENV=prod tsx src/server/Server.ts",
    "dev": "cross-env GAME_ENV=dev vite",
    "dev:host": "cross-env GAME_ENV=dev VITE_HOST=lan vite",
    "docs:map-generator": "cd map-generator && go doc -cmd -u -all",
    "tunnel": "npm run build-prod && npm run start:server",
    "test": "vitest run",
    "perf": "npx tsx tests/perf/run-all.ts",
    "perf:game": "npx tsx tests/perf/fullgame/FullGamePerf.ts",
    "perf:client": "npx tsx tests/perf/client/ClientUpdatePerf.ts",
    "perf:client-mem": "npx tsx tests/perf/client/ClientMemoryPerf.ts",
    "perf:client-tick": "npx tsx tests/perf/client/ClientTickPerf.ts",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --ignore-unknown --write .",
    "format:map-generator": "cd map-generator && go fmt .",
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "lint:fix": "npm run lint:oxlint:fix && npm run lint:eslint:fix",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:github": "oxlint --format=github && eslint --format gha",
    "lint:eslint": "eslint",
    "lint:eslint:fix": "eslint --fix",
    "prepare": "husky",
    "gen-maps": "cd map-generator && go run -tags nodynamic . && npm run format",
    "inst": "npm ci --ignore-scripts"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,jsx,tsx}": [
      "oxlint --fix",
      "eslint --fix"
    ],
    "**/*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/benchmark": "^2.1.5",
    "@types/d3": "^7.4.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/hammerjs": "^2.0.46",
    "@types/howler": "^2.2.12",
    "@types/msgpack5": "^3.4.6",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "benchmark": "^2.1.4",
    "canvas": "^3.2.3",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "d3": "^7.9.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-gha": "^2.0.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "lit": "^3.3.2",
    "marked": "^18.0.5",
    "mrmime": "^2.0.1",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sh": "^0.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.16",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.1.11",
    "vitest-canvas-mock": "^1.1.4"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "colord": "^2.9.3",
    "compression": "^1.8.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "howler": "^2.2.4",
    "intl-messageformat": "^11.2.3",
    "jose": "^6.2.3",
    "lil-gui": "^0.21.0",
    "nanoid": "^5.1.16",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "zod": "^4.4.2"
  },
  "type": "module"
}
